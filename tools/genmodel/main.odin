// Generates static/models/sphere.glb (make models): a UV sphere of radius 1 centred on the origin.
// The physics and scriptdemo scenes scale it by SPHERE_MODEL_RADIUS = 1, so the ball collider matches.
// The file is rewritten only when its bytes change.
package main

import "core:fmt"
import "core:math"
import "core:os"

SPHERE_PATH :: "static/models/sphere.glb"
SEGMENTS :: 32
RINGS :: 16

Mesh :: struct {
	positions: [dynamic][3]f32,
	normals:   [dynamic][3]f32,
	uvs:       [dynamic][2]f32,
	indices:   [dynamic]u16,
}

main :: proc() {
	mesh := build_sphere()
	if !write_if_changed(SPHERE_PATH, build_glb(mesh)) do os.exit(1)
}

build_sphere :: proc() -> (mesh: Mesh) {
	for i in 0 ..= RINGS {
		theta := math.PI * f32(i) / RINGS
		for j in 0 ..= SEGMENTS {
			phi := 2 * math.PI * f32(j) / SEGMENTS
			n := [3]f32{math.sin(theta) * math.cos(phi), math.cos(theta), math.sin(theta) * math.sin(phi)}
			append(&mesh.positions, n)
			append(&mesh.normals, n)
			append(&mesh.uvs, [2]f32{f32(j) / SEGMENTS, f32(i) / RINGS})
		}
	}
	// Counter-clockwise seen from outside. Pole rows have one degenerate triangle per quad, so skip it.
	for i in 0 ..< RINGS {
		for j in 0 ..< SEGMENTS {
			a := u16(i * (SEGMENTS + 1) + j)
			c := a + 1
			b := a + SEGMENTS + 1
			d := b + 1
			if i != 0 do append(&mesh.indices, a, c, d)
			if i != RINGS - 1 do append(&mesh.indices, a, d, b)
		}
	}
	return
}

// GLB 2.0: 12-byte header, JSON chunk and BIN chunk, both padded to 4 bytes.
build_glb :: proc(mesh: Mesh) -> []u8 {
	bin := make([dynamic]u8, context.temp_allocator)
	for p in mesh.positions do for c in p do put_f32(&bin, c)
	normals_offset := len(bin)
	for n in mesh.normals do for c in n do put_f32(&bin, c)
	uvs_offset := len(bin)
	for uv in mesh.uvs do for c in uv do put_f32(&bin, c)
	indices_offset := len(bin)
	for index in mesh.indices do put_u16(&bin, index)

	lo, hi := mesh.positions[0], mesh.positions[0]
	for p in mesh.positions {
		lo = {min(lo.x, p.x), min(lo.y, p.y), min(lo.z, p.z)}
		hi = {max(hi.x, p.x), max(hi.y, p.y), max(hi.z, p.z)}
	}
	vertex_count := len(mesh.positions)
	index_count := len(mesh.indices)

	json := fmt.tprintf(
		`{{"asset":{{"version":"2.0","generator":"generated by tools/genmodel; CC0","copyright":"generated by tools/genmodel; CC0"}},` +
		`"scene":0,"scenes":[{{"nodes":[0]}}],"nodes":[{{"mesh":0,"name":"Sphere"}}],` +
		`"meshes":[{{"primitives":[{{"attributes":{{"POSITION":0,"NORMAL":1,"TEXCOORD_0":2}},"indices":3,"material":0,"mode":4}}]}}],` +
		`"materials":[{{"pbrMetallicRoughness":{{"baseColorFactor":[0.5,0.5,0.5,1],"metallicFactor":0,"roughnessFactor":0.6}},"doubleSided":true}}],` +
		`"accessors":[` +
		`{{"bufferView":0,"componentType":5126,"count":%d,"type":"VEC3","min":[%v,%v,%v],"max":[%v,%v,%v]}},` +
		`{{"bufferView":1,"componentType":5126,"count":%d,"type":"VEC3"}},` +
		`{{"bufferView":2,"componentType":5126,"count":%d,"type":"VEC2"}},` +
		`{{"bufferView":3,"componentType":5123,"count":%d,"type":"SCALAR"}}],` +
		`"bufferViews":[` +
		`{{"buffer":0,"byteOffset":0,"byteLength":%d,"target":34962}},` +
		`{{"buffer":0,"byteOffset":%d,"byteLength":%d,"target":34962}},` +
		`{{"buffer":0,"byteOffset":%d,"byteLength":%d,"target":34962}},` +
		`{{"buffer":0,"byteOffset":%d,"byteLength":%d,"target":34963}}],` +
		`"buffers":[{{"byteLength":%d}}]}}`,
		vertex_count, lo.x, lo.y, lo.z, hi.x, hi.y, hi.z,
		vertex_count, vertex_count, index_count,
		normals_offset,
		normals_offset, uvs_offset - normals_offset,
		uvs_offset, indices_offset - uvs_offset,
		indices_offset, len(bin) - indices_offset,
		len(bin),
	)
	json_bytes := transmute([]u8)json
	json_padded := len(json_bytes) + (4 - len(json_bytes) % 4) % 4
	// bin is 4-byte aligned by construction: every part above is a multiple of 4 bytes.

	out := make([dynamic]u8, context.temp_allocator)
	put_u32(&out, 0x46546C67) // "glTF"
	put_u32(&out, 2)
	put_u32(&out, u32(12 + 8 + json_padded + 8 + len(bin)))
	put_u32(&out, u32(json_padded))
	put_u32(&out, 0x4E4F534A) // "JSON"
	append(&out, ..json_bytes)
	for len(out) % 4 != 0 do append(&out, ' ')
	put_u32(&out, u32(len(bin)))
	put_u32(&out, 0x004E4942) // "BIN\0"
	append(&out, ..bin[:])
	return out[:]
}

put_u32 :: proc(out: ^[dynamic]u8, v: u32) {
	append(out, u8(v), u8(v >> 8), u8(v >> 16), u8(v >> 24))
}

put_f32 :: proc(out: ^[dynamic]u8, v: f32) {
	put_u32(out, transmute(u32)v)
}

put_u16 :: proc(out: ^[dynamic]u8, v: u16) {
	append(out, u8(v), u8(v >> 8))
}

// Rewrites only when the bytes change, so unchanged assets keep their timestamps.
write_if_changed :: proc(path: string, data: []u8) -> bool {
	old, err := os.read_entire_file(path, context.temp_allocator)
	if err == nil && string(old) == string(data) do return false
	if os.write_entire_file(path, data) != nil {
		fmt.eprintfln("cannot write %s", path)
		return false
	}
	fmt.printfln("wrote %s", path)
	return true
}

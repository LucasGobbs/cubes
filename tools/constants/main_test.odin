package main

import "core:os"
import "core:strings"
import "core:testing"

@(test)
test_parse_and_render_derived :: proc(t: ^testing.T) {
	src := `{"constants": [
		{"name": "TILE_COUNT_SIDE", "value": 6, "comment": "tiles per side"},
		{"name": "TILE_PX", "value": 512},
		{"name": "TILE_COUNT", "expr": "TILE_COUNT_SIDE * TILE_COUNT_SIDE"}
	]}`
	cs, reason := parse_constants(src)
	testing.expect_value(t, reason, "")
	testing.expect_value(t, len(cs), 3)

	slang := render_slang(cs)
	testing.expect(t, strings.contains(slang, "static const uint TILE_COUNT_SIDE = 6; // tiles per side\n"), slang)
	testing.expect(t, strings.contains(slang, "static const uint TILE_COUNT = TILE_COUNT_SIDE * TILE_COUNT_SIDE;\n"), slang)

	odin := render_odin(cs)
	testing.expect(t, strings.contains(odin, "TILE_PX :: 512\n"), odin)
	testing.expect(t, strings.contains(odin, "TILE_COUNT :: TILE_COUNT_SIDE * TILE_COUNT_SIDE\n"), odin)
	testing.expect(t, strings.has_prefix(odin, "// GENERATED by tools/constants from shaders/constants.json: do not edit\npackage city\n"), odin)
}

@(test)
test_render_is_deterministic :: proc(t: ^testing.T) {
	data, err := os.read_entire_file("shaders/constants.json", context.temp_allocator)
	testing.expect_value(t, err, nil)
	a, reason_a := parse_constants(string(data))
	b, reason_b := parse_constants(string(data))
	testing.expect_value(t, reason_a, "")
	testing.expect_value(t, reason_b, "")
	testing.expect_value(t, render_slang(a), render_slang(b))
	testing.expect_value(t, render_odin(a), render_odin(b))
}

@(test)
test_rejects_bad_input :: proc(t: ^testing.T) {
	cases := [?]string{
		`{"constants": [{"name": "lower", "value": 1}]}`,
		`{"constants": [{"name": "2X", "value": 1}]}`,
		`{"constants": [{"name": "CITY-W", "value": 1}]}`,
		`{"constants": [{"name": "A", "value": 1}, {"name": "A", "value": 2}]}`,
		`{"constants": [{"name": "A", "value": -1}]}`,
		`{"constants": [{"name": "A", "value": 1, "expr": "1"}]}`,
		`{"constants": [{"name": "A"}]}`,
		`{"constants": [{"name": "B", "expr": "A * 2"}]}`,
		`{"constants": [{"name": "A", "value": 1}, {"name": "B", "expr": "A +"}, {"name": "C", "expr": "bad"}]}`,
		`{"constants": [{"name": "A", "value": 1, "comment": "two\nlines"}]}`,
		`{"constants": [{"name": "A", "value": 1, "typo": 2}]}`,
		`{"constants": [{"name": "A", "expr": "1; 2"}]}`,
		`{"constants": {}}`,
	}
	for c in cases {
		_, reason := parse_constants(c)
		testing.expectf(t, reason != "", "accepted: %s", c)
	}
}

@(test)
test_write_if_changed_skips_equal_content :: proc(t: ^testing.T) {
	path :: "tools/constants/_write_test.tmp"
	defer os.remove(path)
	testing.expect(t, write_if_changed(path, "same"))
	testing.expect(t, !write_if_changed(path, "same"))
	testing.expect(t, write_if_changed(path, "other"))
}

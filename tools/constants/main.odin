// Generates the city constants shared by Odin and Slang from shaders/constants.json:
//   shaders/constants.slang              Slang module: shaders in shaders/ `import constants;`
//   src/scenes/city/constants_generated.odin
// Run from the repo root (make constants). Files are rewritten only when their content changes.
// A constant with "expr" is copied verbatim into both languages: use integer literals, + - * / ( ) and names
// defined earlier in the file.
package main

import "core:encoding/json"
import "core:fmt"
import "core:os"
import "core:strings"

JSON_PATH :: "shaders/constants.json"
SLANG_PATH :: "shaders/constants.slang"
ODIN_PATH :: "src/scenes/city/constants_generated.odin"
HEADER :: "GENERATED by tools/constants from shaders/constants.json: do not edit"

Constant :: struct {
	name, expr, comment: string,
	value:               i64, // literal, used when expr == ""
}

main :: proc() {
	data, err := os.read_entire_file(JSON_PATH, context.temp_allocator)
	if err != nil do fail("cannot read %s", JSON_PATH)
	constants, reason := parse_constants(string(data))
	if reason != "" do fail("%s: %s", JSON_PATH, reason)
	write_if_changed(SLANG_PATH, render_slang(constants))
	write_if_changed(ODIN_PATH, render_odin(constants))
}

parse_constants :: proc(data: string) -> (constants: []Constant, reason: string) {
	root, err := json.parse_string(data, parse_integers = true, allocator = context.temp_allocator)
	if err != nil do return nil, fmt.tprintf("invalid JSON: %v", err)
	top, is_object := root.(json.Object)
	if !is_object do return nil, "top level must be an object"
	list, is_list := top["constants"].(json.Array)
	if !is_list do return nil, `missing "constants" array`

	out := make([dynamic]Constant, context.temp_allocator)
	defined := make(map[string]bool, context.temp_allocator)
	for item, i in list {
		entry, is_entry := item.(json.Object)
		if !is_entry do return nil, fmt.tprintf("constants[%d]: not an object", i)
		for key in entry {
			switch key {
			case "name", "value", "expr", "comment":
			case:
				return nil, fmt.tprintf("constants[%d]: unknown key %q", i, key)
			}
		}
		c: Constant
		name, has_name := entry["name"].(json.String)
		if !has_name do return nil, fmt.tprintf("constants[%d]: missing name", i)
		if bad := valid_name(name); bad != "" do return nil, fmt.tprintf("constants[%d]: name %q: %s", i, name, bad)
		if defined[name] do return nil, fmt.tprintf("duplicate name %q", name)
		c.name = name

		value, has_value := entry["value"].(json.Integer)
		expr, has_expr := entry["expr"].(json.String)
		switch {
		case has_value && has_expr:
			return nil, fmt.tprintf("%s: give value or expr, not both", name)
		case has_value:
			if value < 0 do return nil, fmt.tprintf("%s: value %d is negative", name, value)
			c.value = value
		case has_expr:
			if bad := check_expr(expr, defined); bad != "" do return nil, fmt.tprintf("%s: expr %q: %s", name, expr, bad)
			c.expr = expr
		case:
			return nil, fmt.tprintf("%s: needs value or expr", name)
		}

		if comment, has := entry["comment"].(json.String); has {
			if strings.contains_any(comment, "\r\n") do return nil, fmt.tprintf("%s: comment must be one line", name)
			c.comment = comment
		}
		defined[name] = true
		append(&out, c)
	}
	return out[:], ""
}

// Returns "" for names Odin and Slang both accept as plain identifiers here: upper case, digits, underscore.
valid_name :: proc(name: string) -> string {
	if name == "" do return "empty"
	if name[0] < 'A' || name[0] > 'Z' do return "must start with A-Z"
	for ch in name {
		if !is_name_char(ch) do return "only A-Z, 0-9 and _ allowed"
	}
	return ""
}

// Tokens: names (already defined), integer literals, + - * / ( ) and spaces.
check_expr :: proc(expr: string, defined: map[string]bool) -> string {
	if strings.trim_space(expr) == "" do return "empty"
	i := 0
	for i < len(expr) {
		ch := expr[i]
		switch {
		case ch == ' ' || ch == '+' || ch == '-' || ch == '*' || ch == '/' || ch == '(' || ch == ')':
			i += 1
		case ch >= '0' && ch <= '9':
			for i < len(expr) && expr[i] >= '0' && expr[i] <= '9' do i += 1
		case ch >= 'A' && ch <= 'Z':
			start := i
			for i < len(expr) && is_name_char(rune(expr[i])) do i += 1
			if !defined[expr[start:i]] do return fmt.tprintf("%q is not defined above", expr[start:i])
		case:
			return fmt.tprintf("character %q not allowed", ch)
		}
	}
	return ""
}

is_name_char :: proc(ch: rune) -> bool {
	return (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_'
}

render_slang :: proc(constants: []Constant) -> string {
	b: strings.Builder
	strings.builder_init(&b, context.temp_allocator)
	fmt.sbprintf(&b, "// %s\n", HEADER)
	strings.write_string(&b, "// Shared city sizes: shaders in shaders/ `import constants;`.\n")
	for c in constants {
		if c.expr == "" {
			fmt.sbprintf(&b, "static const uint %s = %d;", c.name, c.value)
		} else {
			fmt.sbprintf(&b, "static const uint %s = %s;", c.name, c.expr)
		}
		write_comment(&b, c.comment)
		strings.write_byte(&b, '\n')
	}
	return strings.to_string(b)
}

render_odin :: proc(constants: []Constant) -> string {
	b: strings.Builder
	strings.builder_init(&b, context.temp_allocator)
	fmt.sbprintf(&b, "// %s\n", HEADER)
	strings.write_string(&b, "package city\n\n")
	for c in constants {
		if c.expr == "" {
			fmt.sbprintf(&b, "%s :: %d", c.name, c.value)
		} else {
			fmt.sbprintf(&b, "%s :: %s", c.name, c.expr)
		}
		write_comment(&b, c.comment)
		strings.write_byte(&b, '\n')
	}
	return strings.to_string(b)
}

write_comment :: proc(b: ^strings.Builder, comment: string) {
	if comment != "" do fmt.sbprintf(b, " // %s", comment)
}

// Returns true when the file was written.
write_if_changed :: proc(path, content: string) -> bool {
	old, err := os.read_entire_file(path, context.temp_allocator)
	if err == nil && string(old) == content do return false
	if os.write_entire_file_from_string(path, content) != nil do fail("cannot write %s", path)
	fmt.printfln("wrote %s", path)
	return true
}

fail :: proc(format: string, args: ..any) -> ! {
	fmt.eprintfln(format, ..args)
	os.exit(1)
}
